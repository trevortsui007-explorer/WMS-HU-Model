<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="Host.Port" value="31175" />
  </appSettings>
  <connectionStrings configSource="App.local.config" />
  <system.diagnostics>
    <trace autoflush="true">
      <listeners>
        <add name="console" type="System.Diagnostics.ConsoleTraceListener" initializeData="true" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>